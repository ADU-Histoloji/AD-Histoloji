rules_version = '2';
// Histoloji Bölümü uygulaması – veritabanı güvenlik kuralları.
// Firebase konsolu → Firestore Database → Kurallar (Rules) sekmesine olduğu gibi yapıştırıp "Yayınla"ya basın.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function meRef() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function approved() { return signedIn() && exists(meRef()) && get(meRef()).data.onayli == true; }
    function admin() { return approved() && get(meRef()).data.rol == 'yonetici'; }
    function isKurucu() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/public)
        && get(/databases/$(database)/documents/config/public).data.kurucu == request.auth.uid;
    }

    // Bölüm kodunun özeti ve kurucu bilgisi
    match /config/public {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.kurucu == request.auth.uid
        && request.resource.data.keys().hasOnly(['kurucu', 'kodHash']);
      allow update: if admin() && request.resource.data.kurucu == resource.data.kurucu;
      allow delete: if false;
    }

    // Giriş ekranındaki isim listesi (sadece ad ve giriş için gereken teknik adres)
    match /people/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ad', 'email', 'onayli'])
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.onayli == false || isKurucu());
      allow update, delete: if admin();
    }

    // Kişi bilgileri: rol, onay, masa, seminer sırası, doğum günü
    match /users/{uid} {
      allow read: if approved() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ad', 'rol', 'onayli', 'dogumGun', 'dogumAy', 'dogumGoster', 'masa', 'seminerSira', 'kayit'])
        && (
          (request.resource.data.onayli == false && request.resource.data.rol == 'asistan'
            && request.resource.data.masa == null && request.resource.data.seminerSira == null)
          || isKurucu()
        );
      allow update: if admin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dogumGun', 'dogumAy', 'dogumGoster']));
      allow delete: if admin();
    }

    // Ders programı: herkes görür, yöneticiler değiştirir
    match /events/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /notices/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // Bildirim adresleri: herkes sadece kendi cihazını ekler/siler, kimse okuyamaz (gönderen sunucu okur)
    match /tokens/{token} {
      allow read: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 't', 'cihaz']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Preparat arşivi: herkes görür, onaylı kişiler ekler ve düzenler
    match /preps/{id} {
      allow read: if true;
      allow create, update: if approved() && request.resource.data.organ is string && request.resource.data.organ.size() > 0;
      allow delete: if approved();
      match /photos/{pid} {
        allow read: if true;
        allow create: if approved() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
        allow delete: if approved();
      }
    }
  }
}
