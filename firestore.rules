rules_version = '2';
// Histoloji Bölümü uygulaması – veritabanı güvenlik kuralları.
// Firebase konsolu → Firestore Database → Kurallar (Rules) sekmesine olduğu gibi yapıştırıp "Yayınla"ya basın.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function meRef() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function approved() { return signedIn() && exists(meRef()) && get(meRef()).data.onayli == true; }
    function admin() { return approved() && get(meRef()).data.rol == 'yonetici'; }
    function isKurucu() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/public)
        && get(/databases/$(database)/documents/config/public).data.kurucu == request.auth.uid;
    }

    // Kurucu bilgisi (ilk kurulumda bir kere yazılır)
    match /config/public {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.kurucu == request.auth.uid
        && request.resource.data.keys().hasOnly(['kurucu']);
      allow update: if admin() && request.resource.data.kurucu == resource.data.kurucu;
      allow delete: if false;
    }

    // Bölüm kodu: kodun özetinden türetilen belge; kayıt olan kişi kodu bu belgenin varlığıyla doğrular
    match /config/uye {
      allow read: if approved();
      allow write: if admin() || isKurucu();
    }
    match /kodlar/{kid} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if admin() || isKurucu();
      // Eski sürümün isim listesi: sadece taşıma için
      match /kisiler/{uid} {
        allow read, delete: if admin();
      }
    }

    // Giriş kaydı: adın özetinden türetilen adreste, o kişinin giriş için kullanılan teknik adresi.
    // Adı bilmeyen bulamaz, liste alınamaz; isim tutulmaz.
    match /girisler/{h} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['email', 'uid'])
        && (admin() || (request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email));
      allow update, delete: if admin();
    }

    // Eski, herkese açık isim listesi: sadece taşıma için yöneticiler okuyup silebilir
    match /people/{uid} {
      allow read, delete: if admin();
    }

    // Kişi bilgileri: rol, onay, masa, seminer sırası, doğum günü
    match /users/{uid} {
      allow read: if approved() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ad', 'rol', 'onayli', 'dogumGun', 'dogumAy', 'dogumGoster', 'masa', 'seminerSira', 'kayit'])
        && (
          (request.resource.data.onayli == false && request.resource.data.rol == 'asistan'
            && request.resource.data.masa == null && request.resource.data.seminerSira == null)
          || isKurucu()
        );
      allow update: if admin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dogumGun', 'dogumAy', 'dogumGoster']))
        // Onaylı kişi kendi daimi masasını seçebilir (1–8) ya da bırakabilir
        || (approved() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['masa'])
            && (request.resource.data.masa == null
                || (request.resource.data.masa is int && request.resource.data.masa >= 1 && request.resource.data.masa <= 8)));
      allow delete: if admin();
    }

    // Ders programı: onaylı üyeler görür, yöneticiler değiştirir
    match /events/{id} {
      allow read: if approved();
      allow write: if admin();
      // Seminer sunan kişi sadece kendi seminerinin konusunu değiştirebilir
      allow update: if approved() && resource.data.k == 'M' && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['topic'])
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 200;
    }
    match /notices/{id} {
      allow read: if approved();
      allow write: if admin();
    }

    // Bildirim adresleri: herkes sadece kendi cihazını ekler/siler, kimse okuyamaz (gönderen sunucu okur)
    match /tokens/{token} {
      allow read: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 't', 'cihaz']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Masa kapasiteleri (1 veya 2 kişilik)
    match /config/masalar {
      allow read: if approved();
      allow write: if admin();
    }

    // Seminer sırası ayarları: seminer yapılmayacak Salılar
    match /config/seminer {
      allow read: if approved();
      allow write: if admin();
    }

    // Her uygulama konusunun anlatıcısı
    match /anlaticilar/{id} {
      allow read: if approved();
      allow write: if admin();
      // Asistan anlatıcısı olmayan bir konuyu kendi adına alabilir, kendi aldığını bırakabilir
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['s', 'topic', 'ad', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ad == get(meRef()).data.ad;
      allow delete: if approved() && resource.data.uid == request.auth.uid;
    }

    // Uygulama günlerinde katılım ve o günlük masa değişikliği
    match /katilim/{gun}/kisiler/{uid} {
      allow read: if approved();
      allow create, update: if approved() && (request.auth.uid == uid || admin())
        && request.resource.data.keys().hasOnly(['durum', 'masa', 't'])
        && request.resource.data.durum in ['evet', 'hayir'];
      allow delete: if approved() && (request.auth.uid == uid || admin());
    }

    // Fakülte ders programlarında bulunan değişiklikler (sunucu yazar, yöneticiler görür ve "baktım" der)
    match /degisiklikler/{id} {
      allow read: if admin();
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum']);
      allow delete: if admin();
    }

    // Uygulama içi bildirim kutusu (sunucu yazar)
    match /duyurular/{id} {
      allow read: if approved();
      allow write: if false;
    }
    match /yoneticiDuyurulari/{id} {
      allow read: if admin();
      allow write: if false;
    }

    // Preparat arşivi: onaylı kişiler görür, ekler ve düzenler
    match /preps/{id} {
      allow read: if approved();
      allow create, update: if approved() && request.resource.data.organ is string && request.resource.data.organ.size() > 0;
      allow delete: if approved();
      match /photos/{pid} {
        allow read: if approved();
        allow create: if approved() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
        allow delete: if approved();
      }
    }
  }
}
